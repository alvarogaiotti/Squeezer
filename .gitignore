/target
*.dll
*.lib
*.lin
*.pbn
# The parser fixtures live in crates/*/tests/fixtures, not at the root.
!crates/*/tests/fixtures/*.lin
!crates/*/tests/fixtures/*.pbn
libdds*
.idea/
dds290-dll/
rusty-tags.vi
.cargo/
.replit/
.replit*
dds/target
hash_testing.py

# `Cargo.lock` is deliberately tracked; see the Gotchas in AGENTS.md.

# Local working directories and third-party reference checkouts; not part of
# the crate. The issue tracker lives in `.scratch/` locally and the OpenCode
# session state in `.opencode/`.
/.scratch/
/.opencode/
/tmp/
/references/

# Browser archives can contain live credentials and session cookies.
*.har
